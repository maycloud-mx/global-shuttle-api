generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  roleId       Int       @map("role_id") @db.UnsignedInt
  email        String    @unique @db.VarChar(191)
  username     String    @unique @db.VarChar(100)
  /// Almacena únicamente el hash de la contraseña, nunca el valor en texto plano.
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement()) @db.UnsignedInt
  name        String           @unique @db.VarChar(100)
  code        String           @unique @db.VarChar(50)
  description String?          @db.VarChar(255)
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       User[]
  permissions RoleMenuAction[]

  @@index([isActive])
  @@map("roles")
}

model Action {
  id          Int              @id @default(autoincrement()) @db.UnsignedInt
  name        String           @db.VarChar(100)
  code        String           @unique @db.VarChar(50)
  description String?          @db.VarChar(255)
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RoleMenuAction[]

  @@index([isActive])
  @@map("actions")
}

model Module {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  icon        String?  @db.VarChar(100)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  menus       Menu[]

  @@index([isActive, sortOrder])
  @@map("modules")
}

model Menu {
  id          Int              @id @default(autoincrement()) @db.UnsignedInt
  moduleId    Int              @map("module_id") @db.UnsignedInt
  parentId    Int?             @map("parent_id") @db.UnsignedInt
  name        String           @db.VarChar(100)
  code        String           @unique @db.VarChar(80)
  route       String?          @db.VarChar(255)
  icon        String?          @db.VarChar(100)
  sortOrder   Int              @default(0) @map("sort_order")
  isVisible   Boolean          @default(true) @map("is_visible")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  parent      Menu?            @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Menu[]           @relation("MenuHierarchy")
  permissions RoleMenuAction[]

  @@index([moduleId, isActive, sortOrder])
  @@index([parentId])
  @@map("menus")
}

model RoleMenuAction {
  roleId    Int      @map("role_id") @db.UnsignedInt
  menuId    Int      @map("menu_id") @db.UnsignedInt
  actionId  Int      @map("action_id") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  action    Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId, actionId])
  @@index([menuId])
  @@index([actionId])
  @@map("role_menu_actions")
}

model Currency {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  name      String   @unique @db.VarChar(100)
  code      String   @unique @db.VarChar(10)
  status    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("currencies")
}
