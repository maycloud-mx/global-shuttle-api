NODE_ENV=development
PORT=3000
# Comma-separated origins. Use * only for local development.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=global_shuttle
DB_USERNAME=root
DB_PASSWORD=change_me

# Use a long, random value in every environment.
JWT_SECRET=change_me_to_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN_SECONDS=28800

# SMTP email delivery. Port 465 normally uses SMTP_SECURE=true;
# port 587 normally uses SMTP_SECURE=false (STARTTLS).
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailer@example.com
SMTP_PASSWORD=change_me
SMTP_FROM_NAME=Global Shuttle
SMTP_FROM_EMAIL=mailer@example.com
