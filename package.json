{
  "name": "global-shuttle-api",
  "version": "0.0.1",
  "description": "Backend API for Global Shuttle",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node scripts/verify-build-source.mjs && tsc -p tsconfig.build.json && node scripts/copy-prisma-client.mjs",
    "db:generate": "prisma generate",
    "db:introspect": "prisma db pull",
    "db:migrate": "prisma migrate dev",
    "db:seed:admin": "prisma db execute --schema prisma/schema.prisma --file prisma/seeds/grant-admin-all-permissions.sql",
    "db:studio": "prisma studio",
    "db:migrate:deploy": "prisma migrate deploy",
    "package:hostinger": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/create-hostinger-zip.ps1",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "postinstall": "prisma generate",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "12.1.2",
    "@prisma/client": "^6.12.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "prisma": "^6.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.1.2",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "vitest": "^4.1.2"
  }
}
